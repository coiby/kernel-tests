# trigger on changes to this code in the damengine subsystem
#
target_sources:
  - drivers/dma/ioat/.*
  - drivers/dma/dmaengine.c
  - include/linux/dmaengine.h

# if something changes with the dma api codepath
# then make sure we are still functioning
#
trigger_sources:
  # DMA API
  - include/linux/dma-mapping.h
  - include/linux/dma-direct.h
  - kernel/dma/direct.c
  - kernel/dma/coherent.c
  - kernel/dma/mapping.c
  # IOMMU core and Intel IOMMU
  - drivers/iommu/dma-iommu.*
  - drivers/iommu/intel/.*
  - drivers/iommu/iommu.c
  - drivers/iommu/iova.c
