summary: Special deadline_test on rt kernel
discover:
    how: fmf
    test:
        - /rt-tests/sched_deadline
execute:
    how: tmt
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/rhivos.sh
          install_repos
    - name: Install packages
      how: install
      package: [realtime-tests]
environment-file:
    - ./rt-tests/sched_deadline/plans/tmt.env
