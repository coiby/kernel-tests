summary: Test to detect System Management Interrupts (SMIs)
discover:
    how: fmf
    test:
        - /rt-tests/smidetect
execute:
    how: tmt
    framework: shell
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/rhivos.sh
          install_repos
    - name: Install packages
      how: install
      package: [realtime-tests]
environment-file:
    - ./rt-tests/smidetect/plans/tmt.env
