summary: Template test case for RTS
discover:
    how: fmf
    test:
        - /rt-tests/template
execute:
    how: tmt
    framework: shell
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/rhivos.sh
          install_repos
    - name: Install packages
      how: install
      package: [wget,gcc]
environment-file:
    - ./rt-tests/template/plans/tmt.env

