summary: RHIVOS test environment setup and kernel check for rt-tests
discover:
    how: fmf
    test:
        - /rt-tests/auto_kernel_check
execute:
    how: tmt
    framework: shell
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/rhivos.sh
          install_repos
    - name: Install packages
      how: install
      package:
          [
              realtime-tests,
              stress-ng,
              stalld,
              bc,
              curl,
              gcc,
              gdb,
              git,
              patch,
              pciutils,
              rpm-build,
              strace,
              time,
              unzip,
              wget,
              zip,
              python3,
              python3-pip,
          ]
environment-file:
    - ./rt-tests/auto_kernel_check/plans/tmt.env
