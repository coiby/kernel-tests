summary: Verify CPUs should be running the highest possible priority task
discover:
    how: fmf
    test:
        - /rt-tests/rt_migrate_test
execute:
    how: tmt
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/rhivos.sh
          install_repos
    - name: Install packages
      how: install
      package: [realtime-tests]
environment-file:
    - ./rt-tests/rt_migrate_test/plans/tmt.env
