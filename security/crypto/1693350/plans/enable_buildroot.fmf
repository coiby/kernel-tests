summary: Security Crypto verifier for 1693350
discover:
  - name: buildroot
    how: fmf
    url: https://gitlab.cee.redhat.com/sbertram/kernel
    ref: tft_phase1
    path: /distribution/install/rhel-buildroot
    test: /
execute:
    how: tmt
    framework: beakerlib
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./security/include/include.h
        install_repos
  - name: Install packages
    how: install
    package: [make, curl, dnf-plugins-core]
environment-file:
        - ./security/crypto/1693350/plans/tmt.env
