summary: Security Crypto verifier for 1693350
discover:
  - name: Verifier for 1693350
    how: fmf 
    test: /security/crypto/1693350/tests/1693350
execute:
    how: tmt
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./automotive/include/rhivos.sh
        install_repos
environment-file:
        - ./security/crypto/1693350/plans/tmt.env
