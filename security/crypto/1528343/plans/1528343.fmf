summary: Security Crypto verifier for 1528343
discover:
    how: fmf
    test:
        - /security/crypto/1528343/tests/1528343
execute:
    how: tmt
    framework: beakerlib
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./security/include/include.h
        install_repos
  - name: Install packages
    how: install
    package: [gcc, make]
environment-file:
        - ./security/crypto/1528343/plans/tmt.env
