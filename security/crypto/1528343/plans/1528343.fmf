summary: Security Crypto verifier for 1528343
discover:
    how: fmf
    test:
        - /security/crypto/1528343/tests/1528343
execute:
    how: tmt
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./automotive/include/rhivos.sh
        install_repos
environment-file:
        - ./security/crypto/1528343/plans/tmt.env
