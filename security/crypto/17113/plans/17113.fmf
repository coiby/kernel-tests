summary: Security Crypto verifier for 17113
discover:
    how: fmf
    test:
        - /security/crypto/17113/tests/17113
execute:
    how: tmt
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./automotive/include/rhivos.sh
        install_repos
environment-file:
        - ./security/crypto/17113/plans/tmt.env
