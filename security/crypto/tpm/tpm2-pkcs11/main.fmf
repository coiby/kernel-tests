summary: Tests for the PKCS#11 interface on TPM2 hardware
contact: Denis Aleksandrov <daleksan@redhat.com>
path: /security/crypto/tpm/tpm2-pkcs11
test: bash ./runtest.sh
component:
  - kernel
framework: beakerlib
require:
  - tpm2-tools
  - tpm2-abrmd
  - tpm2-tss
  - tpm2-pkcs11
  - tpm2-pkcs11-tools
  - opensc
  - openssl
duration: 40m
