summary: Security Crypto enable_fips
discover:
    how: fmf
    test:
        - /security/crypto/enable_fips/tests/enable_fips
execute:
    how: tmt
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./automotive/include/rhivos.sh
        install_repos
environment-file:
        - ./security/crypto/enable_fips/plans/tmt.env
