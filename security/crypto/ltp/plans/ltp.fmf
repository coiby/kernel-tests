summary: Security Crypto ltp
discover:
    how: fmf
    test:
        - /security/crypto/ltp/tests/ltp
execute:
    how: tmt
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./automotive/include/rhivos.sh
        install_repos
environment-file:
        - ./security/crypto/ltp/plans/tmt.env
