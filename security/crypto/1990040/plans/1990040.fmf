summary: Security Crypto verifier for 1990040
discover:
    how: fmf
    test:
        - /security/crypto/1990040/tests/1990040
execute:
    how: tmt
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./automotive/include/rhivos.sh
        install_repos
environment-file:
        - ./security/crypto/1990040/plans/tmt.env
