summary: Security Crypto verifier for 1990040
discover:
    how: fmf
    test:
        - /security/crypto/1990040/tests/1990040
execute:
    how: tmt
    framework: beakerlib
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./security/include/include.h
        install_repos
  - name: Install packages
    how: install
    package: [make]
environment-file:
        - ./security/crypto/1990040/plans/tmt.env
