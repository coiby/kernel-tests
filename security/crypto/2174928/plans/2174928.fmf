summary: Security Crypto verifier for 2174928
discover:
    how: fmf
    test:
        - /security/crypto/2174928/tests/2174928
execute:
    how: tmt
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./automotive/include/rhivos.sh
        install_repos
environment-file:
        - ./security/crypto/2174928/plans/tmt.env

