summary: Security Crypto verifier for 1600394
discover:
    how: fmf
    test:
        - /security/crypto/1600394/tests/1600394
execute:
    how: tmt
    framework: beakerlib
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./security/include/include.h
        install_repos
  - name: Install packages
    how: install
    package: [python3, make]
environment-file:
        - ./security/crypto/1600394/plans/tmt.env
