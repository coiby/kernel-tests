summary: Security Audit verifier for 2035123
discover:
    how: fmf
    test:
        - /security/audit/2035123/tests/2035123
execute:
    how: tmt
    framework: beakerlib
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./security/include/rhivos.sh
        install_repos
  - name: Install packages
    how: install
    package: [make]
environment-file:
        - ./security/audit/2035123/plans/tmt.env

