summary: Security Audit upstream testsuite
discover:
    how: fmf
    test:
        - /security/audit/testsuite/tests/testsuite
execute:
    how: tmt
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./automotive/include/rhivos.sh
        install_repos
environment-file:
        - ./security/audit/testsuite/plans/tmt.env
