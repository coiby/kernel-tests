summary: Security Audit verifier for 2028871
discover:
    how: fmf
    test:
        - /security/audit/2028871/tests/2028871
execute:
    how: tmt
    framework: beakerlib
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./security/include/include.h
        install_repos
  - name: Install packages
    how: install
    package: [make]
environment-file:
        - ./security/audit/2028871/plans/tmt.env

