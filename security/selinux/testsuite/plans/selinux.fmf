summary: selinux testsuite security tests
discover:
    how: fmf
    test:
        - /security/selinux/testsuite/tests
execute:
    how: tmt
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./automotive/include/rhivos.sh
        install_repos
environment-file:
        - ./security/selinux/testsuite/plans/tmt.env
