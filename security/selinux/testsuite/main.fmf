summary: Selinux testsuite security tests
contact: Linqing Lu <lilu@redhat.com>
id: d119e344-5fde-4701-9b61-7bfea3681f5e
component:
  - kernel
path: /security/selinux/testsuite
require: 
  - attr
  - audit
  - checkpolicy
  - coreutils
  - curl
  - dosfstools
  - e2fsprogs
  - elfutils-libelf-devel
  - expect
  - gcc
  - git
  - grep
  - iptables
  - keyutils-libs-devel
  - libbpf-devel
  - libibverbs-devel
  - libselinux-devel
  - libselinux-utils
  - libsepol-devel
  - libuuid-devel
  - lksctp-tools-devel
  - make
  - nc
  - netlabel_tools
  - net-tools
  - nftables
  - nmap-ncat
  - perl-Test
  - perl-Test-Harness
  - perl-Test-Simple
  - policycoreutils
  - policycoreutils-devel
  - python3-lxml
  - quota
  - rdma-core-devel
  - selinux-policy-devel
  - setools-console
  - xfsprogs-devel
  - type: file
    pattern:
        -  /kernel-include
        -  /cki_lib
recommend:
  - policycoreutils-python
  - python2-lxml
  - jfsutils
test: bash ./runtest.sh
framework: beakerlib
duration: 1h
# set avc check back to default that is disabled
# until there is a better solution:
# https://github.com/teemtee/tmt/issues/3611
check-:
  - how: avc
adjust+:
  - when: KernelTier1 == 1
    description: Run the test using specific version of the testsuite.
    id: ""
    tag+:
     - KernelTier1
    environment+:
     GIT_BRANCH: 6aba9eb5ba78bcabe8abb5e3809f3680dc0403a1
  - when: stream is defined and stream != ystream
    enabled: false
  # set avc check back to default that is disabled
  # until there is a better solution:
  # https://github.com/teemtee/tmt/issues/3611
  - when: check-result == info
    check-:
      - how: avc
        result: info
  # kernel debug is slow, double the test runtime
  - when: package-name ~ kernel.*debug
    duration+: "*2"
