summary: Kernel KRSI selftests
discover:
    how: fmf
    test:
        - /security/krsi/tests/krsi
execute:
    how: tmt
    framework: beakerlib
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./automotive/include/rhivos.sh
        install_repos
environment-file:
        - ./security/krsi/plans/tmt.env
