summary: Security Integrity ltp
description: ''
contact: Linqing Lu <lilu@redhat.com>
id: d955bc5b-58bb-420a-ae46-5b0f940daae3
component:
  - kernel
path: /security/integrity/ltp
test: make run
framework: beakerlib
require:
    - autoconf
    - automake
    - bison
    - elfutils-libelf-devel
    - flex
    - gcc
    - git
    - glibc-headers
    - kernel-headers
    - keyutils-libs-devel
    - libacl-devel
    - libcap-devel
    - libselinux-devel
    - libtirpc-devel
    - lksctp-tools-devel
    - m4
    - make
    - numactl-devel
    - openssl
    - openssl-devel
    - pkgconf
    - xfsprogs-devel
    - grubby
    - type: file
      pattern:
          - /kernel-include
          - /cmdline_helper
recommend:
    - abootimg
duration: 5h
extra-summary: /kernel-tests/security/integrity/ltp
extra-task: /kernel-tests/security/integrity/ltp
