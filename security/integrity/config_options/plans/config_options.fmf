summary: Security Integrity config_options
discover:
    how: fmf
    test:
        - /security/integrity/config_options/tests/config_options
execute:
    how: tmt
    framework: beakerlib
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./security/include/include.h
        install_repos
  - name: Install packages
    how: install
    package: [grubby, make]
environment-file:
        - ./security/integrity/config_options/plans/tmt.env
