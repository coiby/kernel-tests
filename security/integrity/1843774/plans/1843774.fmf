summary: Security Integrity verifier for 1843774
discover:
    how: fmf
    test:
        - /security/integrity/1843774/tests/1843774
execute:
    how: tmt
    framework: beakerlib
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./security/include/include.h
        install_repos
  - name: Install packages
    how: install
    package: [grubby, make]
environment-file:
        - ./security/integrity/1843774/plans/tmt.env
