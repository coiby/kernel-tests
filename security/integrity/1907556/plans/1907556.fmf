summary: Security Integrity verifier for 1907556
discover:
    how: fmf
    test:
        - /security/integrity/1907556/tests/1907556
execute:
    how: tmt
    framework: beakerlib
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./security/include/include.h
        install_repos
  - name: Install packages
    how: install
    package: [keyutils, make]
environment-file:
        - ./security/integrity/1907556/plans/tmt.env
