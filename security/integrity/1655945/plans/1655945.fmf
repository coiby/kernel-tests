summary: Security Integrity verifier for 1655945
discover:
    how: fmf
    test:
        - /security/integrity/1655945/tests/1655945
execute:
    how: tmt
    framework: beakerlib
prepare:
  - name: Enable Repos
    how: shell
    script: |
        . ./security/include/include.h
        install_repos
  - name: Install packages
    how: install
    package: [make, ima-evm-utils, keyutils, openssl]
environment-file:
        - ./security/integrity/1655945/plans/tmt.env
