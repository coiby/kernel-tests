summary: Baseline tests for QAT userspace packages to be run with Testing Farm
contact: Denis Aleksandrov <daleksan@redhat.com>
path: /security/qat
test: bash ./runtest.sh
require:
  - beakerlib
  - qatlib
  - qatlib-service
  - qatengine
  - qatlib-tests
  - qatzip
  - gcc
  - clang
  - wget
  - unzip
  - git
  - automake
  - libtool
  - openssl
  - openssl-devel
  - numactl-devel
  - nasm
  - zlib-devel
  - pip
  - bzip2
duration: 45m
