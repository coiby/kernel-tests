summary: LTP security tests
contact: Linqing Lu <lilu@redhat.com>
id: 4df6ea67-424c-4643-a3da-a1760a55477e
component:
  - kernel
path: /security/ltp
test: bash ./runtest.sh
framework: beakerlib
require:
  - autoconf
  - automake
  - bison
  - elfutils-libelf-devel
  - flex
  - gcc
  - git
  - glibc-headers
  - kernel-headers
  - keyutils-libs-devel
  - libacl-devel
  - libcap-devel
  - libselinux-devel
  - libtirpc-devel
  - lksctp-tools-devel
  - m4
  - make
  - openssl
  - openssl-devel
  - pkgconf
  - xfsprogs-devel
  - type: file
    pattern:
        - /kernel-include
recommend:
  - numactl-devel
duration: 4h
