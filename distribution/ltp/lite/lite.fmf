summary: Linux Test Project
description: |
    Latest LTP test KernelTier1
contact: Kernel General Test Team <kernel-general-test-team@redhat.com>
id: b0206110-a3c2-4d2b-ab75-18c9727f5fcc
component:
  - kernel
  - glibc
test: bash ./runtest.sh
tag:
  - KT1-9
  - KernelTier1
  - KernelAutomotiveTier1
framework: shell
require:
  - procmail
  - automake
  - autoconf
  - flex
  - bison
  - rng-tools
  - rsyslog
  - util-linux
  - bc
  - gcc
  - bzip2
  - rpm-build
  - libaio-devel
  - libcap-devel
  - numactl-devel
  - numactl
  - strace
  - wget
  - initscripts-service
  - iputils
  - type: file
    pattern:
      - /cki_lib
      - /distribution/ltp/include
      - /distribution/ltp/include-ng
      - /distribution/ltp/kirk
recommend:
  - python3-click
duration: 6h
adjust+:
  - when: package-name ~ kernel.*debug
    enabled: false
extra-summary: /kernel/distribution/ltp/lite
extra-task: /kernel/distribution/ltp/lite
