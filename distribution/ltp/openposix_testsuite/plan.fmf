summary: Linux Test Project openposix testsuite KernelTier1
discover:
    how: fmf
    test:
        - /distribution/ltp/openposix_testsuite
execute:
    how: tmt
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/rhivos.sh
          install_repos
    - name: Install packages
      how: install
      package:
          [
              git,
              automake,
              autoconf,
              flex,
              bison,
              rsyslog,
              util-linux,
              rpm-build,
              bc,
              time,
              libaio-devel,
              libcap-devel,
              strace,
              gcc,
              bzip2,
          ]
environment-file:
    - ./distribution/ltp/openposix_testsuite/tmt.env
