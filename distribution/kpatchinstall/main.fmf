summary: "Installs required kernel and kpatch RPMs"
contact: Yulia Kopkova <ykopkova@redhat.com>
test: chmod a+x ./runtest.sh
path: /distribution/kpatchinstall
framework: shell
require:
  - test(kernel-include)
  - test(/distribution/kernelinstall)
  - kpatch
  - yum-utils
recommend:
  - iproute
  - ethtool
environment:
    KERNELARGNAME: kernel
duration: 120m
extra-summary: /distribution/kpatchinstall
extra-task: /distribution/kpatchinstall
