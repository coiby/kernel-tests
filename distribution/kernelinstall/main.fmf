summary: "Reports back on the Kernel \tinstallation that was done"
contact: Jiri Kastner <jkastner@redhat.com>
test: bash ./runtest.sh
path: /kernelinstall
framework: shell
require:
  - test(/kernel/include)
recommend:
  - iproute
  - ethtool
environment:
    KERNELARGNAME: kernel
duration: 120m
extra-summary: /distribution/kernelinstall
extra-task: /distribution/kernelinstall
