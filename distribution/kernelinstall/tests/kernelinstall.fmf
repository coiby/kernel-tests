summary: Installs required kernel
contact: Jeff Bastian <jbastian@redhat.com>
test: chmod a+x ./runtest.sh; ./runtest.sh
path: /distribution/kernelinstall
framework: shell
require:
  - iproute
  - ethtool
  - type: file
    pattern:
      - /kernel-include/runtest.sh
duration: 120m
extra-summary: /kernel/distribution/kernelinstall
extra-task: /kernel/distribution/kernelinstall
