check:
  - how: avc
  - how: dmesg
    failure-pattern:
      # These are default patterns
      - 'Call Trace:'
  - how: watchdog
    # Use only SSH ping.
    ping: false
    ssh-ping: true
    reboot: true
adjust:
  - when: check-result == info
    check:
      - how: avc
        result: info
      - how: dmesg
        result: info
        failure-pattern:
          # These are default patterns
          - 'Call Trace:'
      - how: watchdog
        result: info
        # Use only SSH ping.
        ping: false
        ssh-ping: true
        reboot: true
  - when: check-result == disabled
    check:
      - how: avc
        enabled: false
      - how: dmesg
        enabled: false
      - how: watchdog
        enabled: false
