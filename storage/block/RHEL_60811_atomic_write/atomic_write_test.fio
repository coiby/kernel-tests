[global]
name=atomic_write_verify
ioengine=libaio
atomic=1
direct=1
bs=4k
numjobs=1
iodepth=8
time_based=1
runtime=180
#filename=${DEV}
verify_write_sequence=0
verify=crc64
verify_fatal=1
verify_backlog=1
group_reporting

[write_test]
name=write_test
rw=randwrite
size=10G
offset_increment=1G
do_verify=0

[verify_test]
name=verify_test
rw=randread
offset_increment=1G
offset=1G
