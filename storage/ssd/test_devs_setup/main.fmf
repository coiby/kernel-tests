summary: test devs setup for nvme ssd testing  
description: test devs setup for nvme ssd testing 
contact: Yi Zhang <yizhan@redhat.com>
component:
  - kernel
path: /storage/ssd/test_devs_setup
test: bash -x ./runtest.sh
framework: shell 
recommend:
  - beakerlib-redhat
duration: 30m
tag:
  - regression
tier: 1
extra-summary: /storage/ssd/test_devs_setup 
extra-task: /storage/ssd/test_devs_setup
environment:
  TEST_DEVS: nvme0n1
  TEST_DEVS_LIST: /dev/nvme0n1
adjust:
    enabled: false
    when: distro < rhel-7
