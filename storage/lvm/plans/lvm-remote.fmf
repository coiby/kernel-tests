summary: LVM test plan
discover:
  - name: tier1
    how: fmf
    url: https://gitlab.com/redhat/centos-stream/tests/kernel/kernel-tests
    test:
      - /storage/lvm/cache
      - /storage/lvm/thinp/stqe
      - /storage/lvm/device-mapper-persistent-data
      - /storage/lvm/snapper
execute:
    how: tmt
prepare:
  - name: packages
    how: install
    package: [lvm2, device-mapper-persistent-data, python3-pip, python-augeas, git, wget]
  - name: stqe-repo
    how: shell
    script: cd; rm -rf python-stqe; git clone https://gitlab.com/rh-kernel-stqe/python-stqe; cd python-stqe; pip install -U pip; pip install . --user; cd;
provision:
    how: connect
    guest: storageqe-76.lab.eng.brq2.redhat.com
    # password: redhat