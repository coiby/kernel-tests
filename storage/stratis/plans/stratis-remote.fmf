summary: Stratis test plan
discover:
  - name: tier1
    how: fmf
    url: https://gitlab.com/redhat/centos-stream/tests/kernel/kernel-tests
    test:
      - /storage/stratis/common
execute:
    how: tmt
prepare:
  - name: packages
    how: install
    package: [stratis-cli, stratisd, python3-pip, python-augeas, git]
  - name: service
    how: shell
    script: systemctl start stratisd
  - name: stqe-repo
    how: shell
    script: cd; rm -rf python-stqe; git clone https://gitlab.com/rh-kernel-stqe/python-stqe; cd python-stqe; pip install -U pip; pip install . --user; cd;
provision:
    how: connect
    guest: storageqe-76.lab.eng.brq2.redhat.com
    # password: redhat
