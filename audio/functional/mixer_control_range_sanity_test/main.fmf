summary: Test that runs through each mixer control and tests the full range of values
    for that control (also testing values outside of the range)
description: |
    Maintainer: Erik Hamera <ehamera@redhat.com>
    Test steps:
     * Check each mixer control and test the full range of valid values for that control
     * Check each mixer control and test invalid values for that control
     * Check each mixer control and attempt to set its value to the same value it is currently set at
contact: Erik Hamera <ehamera@redhat.com>
component:
  - kernel
test: ./runtest.sh
framework: shell
require:
  - python
  - alsa-utils
  - pciutils
  - type: library
    url: https://gitlab.com/redhat/centos-stream/tests/kernel/kernel-tests.git
    name: /audio/functional
duration: 30m
extra-summary: /kernel/audio_tests/functional/mixer_control_range_sanity_test
extra-task: /kernel/audio_tests/functional/mixer_control_range_sanity_test
id: cb589b44-ab7a-47dd-93f5-fe1e3be36658
