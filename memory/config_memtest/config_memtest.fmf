summary: Verification of the config_memtest variable enablement
description: |
  Test is to verify that config_memtest variable is configured in the kernel when setting memtest=1 and booting the machine
  memtest will occur
contact: Michael Menasherov <mmenashe@redhat.com>
test: bash ./runtest.sh
framework: beakerlib
id: ed438fea-f4d7-43e9-a369-842eac6fb938
require:
    - type: file
      pattern:
        - /cki_lib/libcki.sh
        - /cmdline_helper/libcmd.sh
    - grubby
    - abootimg
extra-summary: memory/config_memtest
extra-task: memory/config_memtest
enabled: true
duration: 5m
