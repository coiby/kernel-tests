summary: Basic tests to ensure proper operation of memfd_secret syscall.
description: |
        Verifies mlock limit, file IO, process_vm_read and ptrace works as expected.
        Test Inputs:
            change_cmdline 'secretmem.enable=1'
            execute kselftest
            remove parameter, change_cmdline '-secretmem.enable=1'
        Expected results:
            [   PASS   ] :: Command 'change_cmdline 'secretmem.enable=1'' (Expected 0, got 0)
            [   PASS   ] :: Command '/usr/libexec/kselftests/mm/memfd_secret' (Expected 0, got 0)
            [   PASS   ] :: Command 'change_cmdline '-secretmem.enable=1'' (Expected 0, got 0)
            OVERALL RESULT: PASS (/memory/memfd_secret/memfd_secret)
        Results location:
            output.txt
contact: Stephen Bertram <sbertram@redhat.com>
id: ad07caa5-edc9-43d1-8350-e651b9c508ed
component:
  - kernel
test: bash ./runtest.sh
framework: beakerlib
recommend:
  - abootimg
  - grubby
require:
  - type: file
    pattern:
      - /kernel-include
      - /cmdline_helper
      - /cki_lib
duration: 30m
