summary: Confirm watchdog system call fuzz testing.
contact: sbertram <sbertram@redhat.com>
component:
  - kernel
test: bash ./runtest.sh
path: /memory/mmra/syzkaller
id: d20d1992-f989-44e8-a501-d814a516a0a6
framework: beakerlib
require:
  - make
  - golang
  - gcc
  - glibc
  - glibc-common
  - glibc-devel
  - gcc-c++
  - wget
  - git
  - patch
  - type: file
    pattern:
        -  /kernel-include
environment:
    mm_syscalls: '"ioctl$WDIOC*"'
    supportcalls: '"syz_open_dev$watchdog"'
duration: 24h
