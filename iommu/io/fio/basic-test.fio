; -- start of job file basic-test.fio --

[global]
directory=/mnt/scratchspace
filesize=${FILESZ}
ioengine=libaio
runtime=${RUNTIME}
time_based=1
thread=1
numjobs=${NJOBS}
bsrange=4k-16k
direct=1
iodepth=${IODEPTH}

[seq-write]
stonewall=1
rw=write

[seq-read]
stonewall=1
rw=read

[rand-write]
stonewall=1
rw=randwrite

[rand-read]
stonewall=1
rw=randread

[write-verify]
stonewall=1
time_based=0
runtime=3m
rw=randwrite
bs=4k
verify=crc32
verify_pattern=0xaa555aa5

; -- end of job file basic-test.fio --