summary: Wait for guest poweroff
discover:
    how: fmf
    test:
        - /misc/wait-guest-poweroff
execute:
    how: tmt
    framework: shell
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/rhivos.sh
          install_repos
    - name: Install packages
      how: install
      package: []
environment-file:
    - ./misc/wait-guest-poweroff/plans/tmt.env
