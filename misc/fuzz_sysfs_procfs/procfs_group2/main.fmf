summary: Fuzz all procfs entries with syzkaller, group 2/2
environment+:
  git_patches: "../misc/fuzz_sysfs_procfs/fuzz_procfs.patch"
adjust+:
  - when: hw_target == rcar_s4
    environment+:
      main_syscalls: |
        "openat$proc_sys_net_ipv4_tcp_syncookies",
