summary: Test kernel syscalls interference between ASIL-B and QM contexts.
description: |
  Test kernel syscalls interference between ASIL-B and QM contexts.
  Fuzz kernel system calls in ASIL-B context, while executing LTP/syscalls test
  suite in QM context to determine if a defect allows the application to
  interfere with another application.
  Test inputs:
      A list with the system calls to be fuzzed, and a fuzzer program
      called syzkaller. Input details:
      - System call list from RA documentation.
      - syzkaller code: https://github.com/google/syzkaller
      - check for execution: grep -q "^${syscall}[$,(]" "${local_dir}"/corpus_dir/*
      LTP/syscalls test suite:
      - https://gitlab.com/redhat/centos-stream/tests/ltp.git, release tag can
        be set with LTP_VERSION.
  Expected results:
      If the system calls are executed without incident during the test runtime,
      the following output should be expected:
      [   LOG    ] :: Test duration was 3602 seconds.
      [   PASS   ] :: No crash results found.
      [   PASS   ] :: acct executed.
      [   PASS   ] :: add_key executed.
      [   PASS   ] :: capget executed.
      [   PASS   ] :: capset executed.
      [   PASS   ] :: clock_gettime executed.
      [   PASS   ] :: close_range executed.
      [   PASS   ] :: copy_file_range executed.
      [   PASS   ] :: delete_module executed.
      [   PASS   ] :: epoll_create1 executed.
      [   PASS   ] :: execve executed.
      [   PASS   ] :: execveat executed.
      [   PASS   ] :: faccessat2 executed.
      [   PASS   ] :: fgetxattr executed.
      [   PASS   ] :: finit_module executed.
      [   PASS   ] :: flistxattr executed.
      [   PASS   ] :: fremovexattr executed.
      [   PASS   ] :: fsconfig executed.
      [   PASS   ] :: fsetxattr executed.
      [   PASS   ] :: fspick executed.
      [   PASS   ] :: fstatfs executed.
      [   PASS   ] :: getitimer executed.
      [   PASS   ] :: getrandom executed.
      [   PASS   ] :: getxattr executed.
      [   PASS   ] :: init_module executed.
      [   PASS   ] :: ioprio_get executed.
      [   PASS   ] :: ioprio_set executed.
      [   PASS   ] :: kcmp executed.
      [   PASS   ] :: kexec_file_load executed.
      [   PASS   ] :: kexec_load executed.
      [   PASS   ] :: keyctl executed.
      [   PASS   ] :: keyctl executed.
      [   PASS   ] :: landlock_add_rule executed.
      [   PASS   ] :: landlock_create_ruleset executed.
      [   PASS   ] :: landlock_restrict_self executed.
      [   PASS   ] :: lgetxattr executed.
      [   PASS   ] :: listxattr executed.
      [   PASS   ] :: llistxattr executed.
      [   PASS   ] :: lremovexattr executed.
      [   PASS   ] :: lsetxattr executed.
      [   PASS   ] :: mq_getsetattr executed.
      [   PASS   ] :: mq_notify executed.
      [   PASS   ] :: mq_open executed.
      [   PASS   ] :: mq_timedreceive executed.
      [   PASS   ] :: mq_timedsend executed.
      [   PASS   ] :: mq_unlink executed.
      [   PASS   ] :: msgctl executed.
      [   PASS   ] :: msgget executed.
      [   PASS   ] :: msgrcv executed.
      [   PASS   ] :: msgsnd executed.
      [   PASS   ] :: name_to_handle_at executed.
      [   PASS   ] :: newfstat executed.
      [   PASS   ] :: newfstatat executed.
      [   PASS   ] :: open_tree executed.
      [   PASS   ] :: openat2 executed.
      [   PASS   ] :: perf_event_open executed.
      [   PASS   ] :: personality executed.
      [   PASS   ] :: pipe2 executed.
      [   PASS   ] :: pivot_root executed.
      [   PASS   ] :: ptrace executed.
      [   PASS   ] :: removexattr executed.
      [   PASS   ] :: renameat2 executed.
      [   PASS   ] :: request_key executed.
      [   PASS   ] :: restart_syscall executed.
      [   PASS   ] :: rseq executed.
      [   PASS   ] :: rt_sigqueueinfo executed.
      [   PASS   ] :: seccomp executed.
      [   PASS   ] :: semctl executed.
      [   PASS   ] :: semget executed.
      [   PASS   ] :: semop executed.
      [   PASS   ] :: semtimedop executed.
      [   PASS   ] :: setfsgid executed.
      [   PASS   ] :: setfsuid executed.
      [   PASS   ] :: setns executed.
      [   PASS   ] :: setreuid executed.
      [   PASS   ] :: setxattr executed.
      [   PASS   ] :: sigaltstack executed.
      [   PASS   ] :: signalfd4 executed.
      [   PASS   ] :: statfs executed.
      [   PASS   ] :: statx executed.
      [   PASS   ] :: syslog executed.
      [   PASS   ] :: syz_open_procfs$userns executed.
      [   PASS   ] :: tee executed.
      [   PASS   ] :: tkill executed.
      [   PASS   ] :: utimensat executed.
      [   PASS   ] :: vhangup executed.
      NOTE: Some LTP tests are unsuitable for execution inside QM (broken or
      failed due to access permissions). Therefore, LTP TFAIL or TBROK log
      messages are expected.
  Results location:
      output.txt
contact: Pablo Ridolfi <pridolfi@redhat.com>
component:
  - kernel
test: bash ./runtest.sh
path: /misc/other-syscalls-fuzzing
framework: beakerlib
require:
  - make
  - golang
  - gcc
  - glibc
  - glibc-common
  - glibc-devel
  - gcc-c++
  - wget
  - git
  - patch
  - type: file
    pattern:
        - /kernel-include
        - /syzkaller
duration: 3h
id: 0c347229-844a-4648-95f9-a0fdb8ffa6d8
environment:
    time: 3600
    SYZKALLER_COMMIT_HASH: "21339d7b9986698282dce93709157dc36907fbf8"
    git_patches: '../misc/other-syscalls-fuzzing/other-syscalls-fuzzing.patch'
    main_syscalls: |
      "acct",
      "add_key",
      "capget",
      "capset",
      "close_range",
      "copy_file_range",
      "delete_module",
      "execve",
      "execveat",
      "faccessat2",
      "fgetxattr",
      "finit_module",
      "flistxattr",
      "fremovexattr",
      "fsconfig",
      "fsetxattr",
      "fspick",
      "fstatfs",
      "getrandom",
      "getxattr",
      "init_module",
      "ioprio_get",
      "ioprio_set",
      "kcmp",
      "kexec_file_load",
      "kexec_load",
      "keyctl",
      "keyctl",
      "landlock_add_rule",
      "landlock_create_ruleset",
      "landlock_restrict_self",
      "lgetxattr",
      "listxattr",
      "llistxattr",
      "lremovexattr",
      "lsetxattr",
      "mq_getsetattr",
      "mq_notify",
      "mq_open",
      "mq_timedreceive",
      "mq_timedsend",
      "mq_unlink",
      "msgctl",
      "msgget",
      "msgrcv",
      "msgsnd",
      "name_to_handle_at",
      "newfstat",
      "newfstatat",
      "open_tree",
      "openat2",
      "perf_event_open",
      "personality",
      "pipe2",
      "pivot_root",
      "ptrace",
      "removexattr",
      "renameat2",
      "request_key",
      "restart_syscall",
      "rseq",
      "rt_sigqueueinfo",
      "seccomp",
      "semctl",
      "semget",
      "semop",
      "semtimedop",
      "setfsgid",
      "setfsuid",
      "setns",
      "setreuid",
      "setxattr",
      "sigaltstack",
      "signalfd4",
      "statfs",
      "statx",
      "syslog",
      "tee",
      "tkill",
      "utimensat",
      "vhangup",
      "clock_gettime",
      "epoll_create1",
      "syz_open_procfs$userns",
      "getitimer"
    support_syscalls: |
      "getpid"
# Exclude LTP tests unsuitable for executing inside QM (broken or failed due to access permissions)
    exclude_ltp_tests: |
      acct01,
      close_range01,
      copy_file_range01,
      execveat01,
      fgetxattr01,
      fremovexattr01,
      fsconfig01,
      fsetxattr01,
      fspick01,
      fstatfs01,
      lremovexattr01,
      open_tree01,
      perf_event_open02,
      personality01,
      seccomp01,
      setxattr01,
      statfs01,
      syslog12
# Following syscalls are covered in Memory Management fuzzing tests
      # "mmap",
      # "munlockall",
      # "set_mempolicy_home_node",
      # "shmat",
      # "shmctl",
      # "shmdt",
      # "shmget",
# rt_sigreturn never returns, remove it from list
      # "rt_sigreturn",
