summary: Simple kernel sanity check that loads and unloads various kernel modules
discover:
    how: fmf
    test:
        - /misc/module-load
execute:
    how: tmt
    framework: beakerlib
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/rhivos.sh
          install_repos
    - name: Install packages
      how: install
      package:
          [
              beakerlib,
              coreutils,
              wget,
              git,
              time,
              patch,
              bzip2,
              autoconf,
              glib2-devel,
              make,
              gettext,
              automake,
              gcc,
              libtool,
              bison,
              flex,
          ]
environment-file:
    - ./misc/module-load/tmt.env
