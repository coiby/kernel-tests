summary: Fuzz all enabled system calls, group 1/2
environment+:
    main_syscalls: |
      "accept",
      "accept4",
      "acct",
      "add_key",
      "adjtimex",
      "bind",
      "bpf",
      "brk",
      "cachestat",
      "capget",
      "capset",
      "chdir",
      "chroot",
      "clock_getres",
      "clock_gettime",
      "clock_nanosleep",
      "syz_clone",
      "syz_clone3",
      "clock_adjtime",
      "close",
      "close_range",
      "connect",
      "copy_file_range",
      "delete_module",
      "dup",
      "dup3",
      "epoll_create1",
      "epoll_ctl",
      "epoll_pwait",
      "epoll_pwait2",
      "execve",
      "execveat",
      "exit",
      "exit_group",
      "faccessat",
      "faccessat2",
      "fadvise64",
      "fallocate",
      "fanotify_init",
      "fanotify_mark",
      "fchdir",
      "fchmod",
      "fchmodat",
      "fchown",
      "fchownat",
      "fcntl",
      "fdatasync",
      "fgetxattr",
      "finit_module",
      "flistxattr",
      "flock",
      "fremovexattr",
      "fsconfig",
      "fsetxattr",
      "fsmount",
      "fsopen",
      "fspick",
      "fstat",
      "fstatfs",
      "fsync",
      "ftruncate",
      "futex",
      "futex_waitv",
      "get_robust_list",
      "getcpu",
      "getcwd",
      "getdents64",
      "getegid",
      "geteuid",
      "getgid",
      "getgroups",
      "getitimer",
      "getpeername",
      "getpgid",
      "getpid",
      "getpriority",
      "getppid",
      "getrandom",
      "getresgid",
      "getresuid",
      "getrlimit",
      "getrusage",
      "getsid",
      "getsockname",
      "getsockopt",
      "gettid",
      "gettimeofday",
      "getuid",
      "getxattr",
      "init_module",
      "inotify_add_watch",
      "inotify_init1",
      "inotify_rm_watch",
      "io_cancel",
      "io_destroy",
      "io_getevents",
      "io_pgetevents",
      "io_setup",
      "io_submit",
      "ioprio_get",
      "ioprio_set",
      "kcmp",
      "kexec_file_load",
      "kexec_load",
      "keyctl",
      "landlock_add_rule",
      "landlock_create_ruleset",
      "landlock_restrict_self",
      "lgetxattr",
      "linkat",
      "listen",
      "listxattr",
      "llistxattr",
      "lremovexattr",
      "lseek",
      "lsetxattr",
      "madvise",
      "membarrier",
      "memfd_create",
      "mincore",
      "mkdirat",
      "mknodat",
      "mlock",
      "mlock2",
      "mlockall",
      "mmap",
      "mount",
      "mount_setattr",
      "move_mount",
      "mprotect",
      "mremap",
      "msgctl",
      "msgget",
      "msgrcv",
      "msgsnd"
    support_syscalls: |
      "syz_open_procfs$userns",
      "socket",
      "openat",
      "ioctl",
      "syz_create_resource$binfmt",
      "openat$binfmt"
# Temporarily disable IPv6 related syscalls, causing VROOM-31214 (added to current not supported mmap syscalls)
# Temporarily disable mq related syscalls, causing VROOM-31209
    disable_syscalls: |
      "ioctl$sock_inet6_SIOCADDRT",
      "ioctl$sock_inet6_SIOCDELRT",
      "ioctl$sock_inet6_SIOCSIFADDR",
      "ioctl$sock_inet6_SIOCDIFADDR",
      "ioctl$sock_inet6_SIOCSIFDSTADDR",
      "mq_getsetattr",
      "mq_notify",
      "mq_open",
      "mq_timedreceive",
      "mq_timedsend",
      "mq_unlink",
      "mmap$DRM_I915",
      "mmap$DRM_MSM",
      "mmap$KVM_VCPU",
      "mmap$bifrost",
      "mmap$dsp",
      "mmap$fb",
      "mmap$qrtrtun",
      "mmap$snddsp",
      "mmap$snddsp_control",
      "mmap$snddsp_status"
    not_present_syscalls: |
      "add_key",
      "cachestat",
      "futex_waitv"
# kill could kill any process, remove it from list
# it is actually disabled in syzkaller as default
      # "kill",
# Small trick - syzkaller cannot give the proper stack pointer to clone(), but we can do it with the aid of pseudo syscalls.
# clone and clone3 replaced with syz_clone and syz_clone3
      # "clone",
      # "clone3",
# Available since kernel 6.6
      # "fchmodat2"
# NUMA not available in RHIVOS
      # "get_mempolicy",
      # "mbind",
      # "migrate_pages",
      # "move_pages",
# Note that futex_* syscalls are opcodes for futex(), see
# https://github.com/google/syzkaller/blob/a3c808e4af7a47dd5051fa1e27a3950d11e59c14/sys/linux/futex.txt#L29
      # "futex_wait",
      # "futex_wake",
      # "futex_requeue",
