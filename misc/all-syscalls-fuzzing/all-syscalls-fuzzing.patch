 # vhangup
 # _sysctl
-# adjtimex
-# swapon
-# swapoff
+adjtimex(buf ptr[inout, timex])
+swapon(path ptr[in, filename], swapflags flags[open_mode])
+swapoff(path ptr[in, string])
 # nfsservctl
-# getcpu
+getcpu(cpu_ptr ptr[out, int32], node_ptr ptr[out, int32], tcache ptr[in, void])
+
+timezone {
+	tz_minuteswest	int32
+	tz_dsttime	int32
+}
 
 # Probably no sense in calling these.
 # Also affect system-wide state, so not reproducible anyway.
-# gettimeofday
-# settimeofday
-# reboot
-# sethostname
-# setdomainname
-# sched_get_priority_max
-# sched_get_priority_min
+gettimeofday(tv ptr[out, timeval], tz ptr[out, timezone])
+settimeofday(tv ptr[in, timeval], tz ptr[in, timezone])
+
+reboot_magic2 = LINUX_REBOOT_MAGIC2, LINUX_REBOOT_MAGIC2A, LINUX_REBOOT_MAGIC2B, LINUX_REBOOT_MAGIC2C
+reboot_cmds = LINUX_REBOOT_CMD_RESTART, LINUX_REBOOT_CMD_HALT, LINUX_REBOOT_CMD_CAD_ON, LINUX_REBOOT_CMD_CAD_OFF, LINUX_REBOOT_CMD_POWER_OFF, LINUX_REBOOT_CMD_SW_SUSPEND
+
+reboot(magic const[LINUX_REBOOT_MAGIC1], magic2 flags[reboot_magic2], cmd flags[reboot_cmds], arg const[0])
+# Command to reboot with a specific string
+reboot$restart2(magic const[LINUX_REBOOT_MAGIC1], magic2 flags[reboot_magic2], cmd const[LINUX_REBOOT_CMD_RESTART2], arg ptr[in, string])
+
+sethostname(name ptr[in, string], len int32)
+setdomainname(name ptr[in, string], len int32)
+
+sched_get_priority_max(policy flags[sched_policy])
+sched_get_priority_min(policy flags[sched_policy])
