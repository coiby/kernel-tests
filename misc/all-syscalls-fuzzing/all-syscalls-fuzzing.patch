+vhangup()
+
 pipefd {
 	rfd	fd
 	wfd	fd
@@ -1406,21 +1412,34 @@ _ = KCOV_INIT_TRACE, KCOV_ENABLE, KCOV_DISABLE, KCOV_TRACE_PC, KCOV_TRACE_CMP, P
 define KCOV_REMOTE_ENABLE	1075340134
 
 # Not yet implemented syscalls:
-# umask
