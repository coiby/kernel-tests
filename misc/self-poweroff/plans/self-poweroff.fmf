summary: Powers itself off
discover:
    how: fmf
    test:
        - /misc/self-poweroff
execute:
    how: tmt
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/rhivos.sh
          install_repos
    - name: Install packages
      how: install
      package: []
environment-file:
    - ./misc/self-poweroff/plans/tmt.env
