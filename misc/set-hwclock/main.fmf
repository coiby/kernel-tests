summary: Set RTC hardware clock
description: |
    A job to set the RTC hardware clock after waiting for ntpd/chronyd to set the system clock.
contact: Oliver Gutierrez <ogutierr@redhat.com>
test: bash ./runtest.sh
framework: beakerlib
require:
  - util-linux
  - chrony
# hwclock is not included in the util-linux build for s390x
adjust+:
  - enabled: false
    when: arch == s390x
duration: 10m
extra-summary: /kernel/misc/set-hwclock
extra-task: /kernel/misc/set-hwclock
