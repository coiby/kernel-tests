summary: kpatch-patch compatibility test
description: |
    kpatch-patch compatibility test with ftrace, kprobes,
    systemtap and crash
contact: Yulia Kopkova <ykopkova@redhat.com>
component:
  - kernel
test: bash ./runtest.sh
framework: beakerlib
require:
  - type: file
    pattern:
      - /general/kpatch/include/lib.sh
      - /security/crypto/enable_fips/lib.sh
recommend:
  - kpatch
  - systemtap
duration: 10m
