summary: clock_getcpuclockid() returns CPU-time clock for a process
discover:
    how: fmf
    test:
        - /general/time/clock_getcpuclockid
execute:
    how: tmt
    framework: shell
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/rhivos.sh
          install_repos
    - name: Install packages
      how: install
      package: [gcc, make]
environment-file:
    - ./general/time/clock_getcpuclockid/plans/tmt.env
