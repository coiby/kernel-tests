summary: Run elapsed time tests
discover:
    how: fmf
    test:
        - /general/time/elapsed
execute:
    how: tmt
    framework: shell
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/rhivos.sh
          install_repos
    - name: Install packages
      how: install
      package: [kernel-devel, kernel-headers, gcc, glibc-devel]
environment-file:
    - ./general/time/elapsed/plans/tmt.env
