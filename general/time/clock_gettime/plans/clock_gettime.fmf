summary: Test time backward for clock_gettime()
discover:
    how: fmf
    test:
        - /general/time/clock_gettime
execute:
    how: tmt
    framework: shell
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/rhivos.sh
          install_repos
    - name: Install packages
      how: install
      package: [gcc, make]
environment-file:
    - ./general/time/clock_gettime/plans/tmt.env
