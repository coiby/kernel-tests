summary: Test the ITIMER_VIRTUAL and ITIMER_PROF by using the setitimer
discover:
    how: fmf
    test:
        - /general/time/itimer
execute:
    how: tmt
    framework: shell
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/rhivos.sh
          install_repos
    - name: Install packages
      how: install
      package: [gcc]
environment-file:
    - ./general/time/itimer/plans/tmt.env
