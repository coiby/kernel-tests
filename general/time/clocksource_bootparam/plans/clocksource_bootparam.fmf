summary: test clocksource=tsc
discover:
    how: fmf
    test:
        - /general/time/clocksource_bootparam
execute:
    how: tmt
    framework: shell
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/rhivos.sh
          install_repos
    - name: Install packages
      how: install
      package: [grubby]
environment-file:
    - ./general/time/clocksource_bootparam/plans/tmt.env
