summary: clock_getres() function check
discover:
    how: fmf
    test:
        - /general/time/clock_getres
execute:
    how: tmt
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/rhivos.sh
          install_repos
    - name: Install packages
      how: install
      package: [gcc, make]
environment-file:
    - ./general/time/clock_getres/plans/tmt.env
