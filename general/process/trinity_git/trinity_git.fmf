summary: Run upstream trinity
description: |
    run upstream trinity to find broken syscalls
    This refers Jan stancek's trinity test in in syscalls/rhel7

    To extract code from git to tgz:
    git archive --format=tgz --output trinity-9f6f9f916da3.tgz --prefix=trinity-9f6f9f916da3/ HEAD
contact: Chunyu Hu <chuhu@redhat.com>
component:
  - kernel
test: bash ./runtest.sh
framework: beakerlib
require:
  - type: file
    pattern:
      - /automotive/include
recommend:
  - kernel
  - kernel-headers
  - json-c-devel
  - gcc
  - patch
  - wget
environment:
    AVC_ERROR: +no_avc_check
duration: 2h
extra-summary: /kernel/general/process/trinity_git
extra-task: /kernel/general/process/trinity_git
id: 142f6e9d-3aad-4d9c-b6ca-66034b04d3f3
