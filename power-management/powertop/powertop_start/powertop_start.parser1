#kernel-qe-hw
#This test tests if powertop service runs - related to BZ1392438
parser lhc1
sysinfo uname lscpu bios
run 0 rpm -qa powertop
#1, 2 and 3 are names of results
run 1 systemctl enable powertop.service
run 2 systemctl start powertop.service
run 3 systemctl status powertop.service
#results are printed to stdout automatically - you'll need to see then in the logs anyway

#hwl, nhwl and ncur are names too; ngrep rips numbers from the output
#both grep and ngrep greps in all results obtained by run commands
grep stat status=0/SUCCESS

echo DATA powertop status is: $[3,stat]

fail_ex [ -z $[3,stat] ]

#if there isn't decided to pass or fail, there is default
default pass
