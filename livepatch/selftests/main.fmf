summary: livepatching selftests
description: |
    This test is used for running kernel livepatch selftests in internal package
    kernel-selftests-internal.
contact: Yulia Kopkova <ykopkova@redhat.com>
component:
  - kernel
path: /livepatch/selftests
test: bash ./runtest.sh
framework: shell
recommend:
  - nmap-ncat
  - kernel-devel
require:
  - gcc
  - elfutils-libelf-devel
  - make
  - type: file
    pattern:
      - /general/kpatch/include/lib.sh
duration: 30m
extra-summary: /kernel/livepatch/selftests
extra-task: /kernel/livepatch/selftests
