summary: filesystems/nfs/connectathon
description: Connectathon Testsuite to test NFS versions 2,3 and 4
contact: Jianhong Yin <jiyin@redhat.com>
component:
  - kernel
test: bash ./runtest.sh
framework: shell
require:
  - wget
  - git
  - gcc
  - make
  - autoconf
  - patch
  - time
  - tar
  - bzip2
  - nfs-utils
  - net-tools
  - wireshark
  - tcpdump
recommend:
  - net-snmp
  - libnsl2
  - libtirpc-devel
  - ethereal
  - rusers
duration: 180m
