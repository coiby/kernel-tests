summary: Test kdump by crashing kernel with hung_task_panic enabled.
description: |
    bug: 1410295
    hung_task: allow hung_task_panic when hung_task_warnings is 0.
    Test hung_task_panic=1 to trigger panic.
contact: Kdump QE <kdump-qe-list@redhat.com>
test: make run
framework: shell
require:
  - gcc
  - kernel-devel
  - kernel-headers
  - elfutils-libelf-devel
duration: 2h
extra-summary: /kernel/kdump/crash-hung-task
extra-task: /kernel/kdump/crash-hung-task
