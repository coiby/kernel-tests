summary: Use ptdump extension for crash to analyse the vmcore
description: |+
    Use ptdump extension for crash to analyse log buffer
    generated by the Intel Processor Trace facility from the vmcore

contact: Kdump QE <kdump-qe-list@redhat.com>
component:
  - crash-ptdump-command
test: make run
framework: shell

require:
  - crash-ptdump-command
  - crash
recommend:
  - kernel-debuginfo
duration: 30m
extra-summary: /kernel/kdump/analyse-crash-ptdump-cmd
extra-task: /kernel/kdump/analyse-crash-ptdump-cmd
