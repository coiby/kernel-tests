summary: Reboot to new kernel via kexec.
discover:
    how: fmf
    test:
        - /kdump/kexec-boot
execute:
    how: tmt
    framework: shell
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/include.sh
          install_repos
    - name: Install packages
      how: install
      package: [TBD_CASE_PACKAGES]
environment-file:
    - ./kdump/kexec-boot/plans/tmt.env
