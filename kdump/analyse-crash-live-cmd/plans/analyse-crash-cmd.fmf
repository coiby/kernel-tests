summary: Use crash utility to analyse a live system
discover:
    how: fmf
    test:
        - /kdump/analyse-crash-live-cmd
execute:
    how: tmt
    framework: shell
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/rhivos.sh
          install_repos
    - name: Install packages
      how: install
      package: []
environment-file:
    - ./kdump/analyse-crash-live-cmd/plans/tmt.env
