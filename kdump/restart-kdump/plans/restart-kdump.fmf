summary: Restart kdump service
discover:
    how: fmf
    test:
        - /kdump/restart-kdump
execute:
    how: tmt
    framework: shell
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/include.sh
          install_repos
    - name: Install packages
      how: install
      package: [TBD_CASE_PACKAGES]
environment-file:
    - ./kdump/restart-kdump/plans/tmt.env
