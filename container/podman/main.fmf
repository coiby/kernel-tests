summary: Podman system test
contact: Kernel General Test Team <kernel-general-test-team@redhat.com>
component:
  - kernel
  - podman
test: ./runtest.sh
require:
  - podman
  - podman-tests
  - buildah
  - openssl
  - socat
  - httpd-tools
  - nmap-ncat
  - skopeo
  - jq
  - git
framework: shell
duration: 3h
extra-summary: container/podman
extra-task: container/podman
adjust+:
  # test doesn't build on rhel before 8.10
  - when: distro < rhel-8.10
    enabled: false
  # don't run on kernel debug
  - when: package-name ~ kernel.*debug
    enabled: false
  # don't run on kernel rt
  - when: package-name ~ kernel.*rt
    enabled: false
/root:
  id: 79c01611-e568-4fd9-aa3a-fd6803599f80
/rootless:
  environment:
    PODMANUSER: podmantest
