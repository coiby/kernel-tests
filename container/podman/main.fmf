  - podman
test: ./runtest.sh
require:
  - podman
  - podman-tests
  - buildah
  - openssl
  - socat
  - httpd-tools
  - nmap-ncat
  - skopeo
  - jq
  - git
framework: beakerlib
duration: 3h
extra-summary: container/podman
extra-task: container/podman
/root:
  id: 79c01611-e568-4fd9-aa3a-fd6803599f80
/rootless:
  environment:
    PODMANUSER: podmantest
