summary: Networking sctp auth socket ops test
discover:
    how: fmf
    test:
        - /networking/sctp/auth/sockopts
execute:
    how: tmt
    framework: shell
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/rhivos.sh
          install_repos
    - name: Install packages
      how: install
      package: []
environment-file:
    - ./networking/sctp/auth/sockopts/plans/tmt.env
