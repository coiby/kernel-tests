summary: Cleanup a wireless connection
discover:
    how: fmf
    test:
        - /networking/wireless/tests/functional/connection/cleanup
execute:
    how: tmt
    framework: shell
prepare:
    - name: Enable Repos
      how: shell
      script: |
          . ./automotive/include/include.sh
          install_repos
    - name: Install packages
      how: install
      package: [nmcli, NetworkManager]
environment-file:
    - ./networking/wireless/tests/functional/connection/cleanup/plans/tmt.env
