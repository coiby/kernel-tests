summary: KG-VMM kselftest
description: test wrapper for kernel selftest
contact: Hangbin Liu <haliu@redhat.com>
component:
  - kernel
test: bash ./runtest.sh
framework: beakerlib
require:
  - autoconf
  - automake
  - beakerlib
  - bison
  - bpftool
  - clang
  - ethtool
  - flex
  - iproute-tc
  - jq
  - llvm
  - net-tools
  - nmap-ncat
  - popt-devel
  - python3
  - tar
  - wget
  - pip
  - type: file
    pattern:
        - /cki_lib
        - /kernel-include
recommend:
  - conntrack-tools
  - fuse
  - iperf3
  - netsniff-ng
  - numactl-libs
  - scapy
  - socat
  - tcpdump
  - valgrind
duration: 24h
tag: KernelAutomotiveTier1
extra-summary: kselftests
extra-task: kselftests
/test:
  id: 83986a89-c53a-4ed6-a17b-6c18216168b8
  adjust+:
    - when: hw_target == rcar_s4
      duration: 30h
    - when: test_suite == kself_compiled
      id: 1d584e6d-4d5e-4a7b-8b78-1f2b0992b583
    - when: test_suite == kself_delivered_bpf
      id: 04676274-1c07-484a-bc10-c2dd5e389632
    - when: test_suite == kself_delivered_net
      id: ea3f511c-2f03-4eee-ae32-900bfa4a23e4
    - when: test_suite == kself_delivered_net_forwarding
      id: 74c72ee5-2334-41f9-9885-72e630160bc4
    - when: test_suite == kself_delivered_netfilter
      id: 2a05643f-5a1a-4d27-b5e0-e19b9af7a79b
    - when: test_suite == kself_delivered_misc
      id: 2c9cb810-504b-44b6-8818-cd2b0ec011b8
    - when: test_suite == kself_concurrent_syscalls
      id: 1b10a1fe-6159-4de5-bbfc-ce6e214f2630
      summary: Ensuring that self-tests are tested concurrently.
      environment+:
        WORKERS: 4
        ARCH: arm64
        BUILD_FROM_SRC: y
        TEST_ITEMS: "mm rseq"
        INCLUDE: "mm.sh"
